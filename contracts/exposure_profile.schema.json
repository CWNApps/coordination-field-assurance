{
  "$schema":"https://json-schema.org/draft/2020-12/schema","type":"object","additionalProperties":false,
  "required":["schema_version","metric_version","tenant_id","deployment_id","window_id","policy_epoch","sde","tcr","icb_bits_upper_bound","prv","coverage","state","evidence_root"],
  "properties":{
    "schema_version":{"const":"1.0.0"},"metric_version":{"const":"CFA-0.2.0-research"},"tenant_id":{"type":"string"},"deployment_id":{"type":"string"},"window_id":{"type":"string"},"policy_epoch":{"type":"string"},
    "sde":{"type":"integer","minimum":0},"tcr":{"type":"number","minimum":0,"maximum":1},"icb_bits_upper_bound":{"type":"number","minimum":0},
    "prv":{"type":"object","additionalProperties":true},"ccp":{"type":["number","null"],"minimum":0},"oce":{"type":["object","null"]},"coverage":{"type":"number","minimum":0,"maximum":1},
    "calibration_id":{"type":["string","null"]},"state":{"enum":["UNKNOWN","RESEARCH_ONLY","SHADOW_VALIDATED","PRODUCTION_ELIGIBLE"]},"warnings":{"type":"array","items":{"type":"string"}},"evidence_root":{"type":"string","pattern":"^[a-f0-9]{64}$"}
  }
}
